          },
          "required": [
            "salon_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_barbers",
        "title": "List barbers",
        "description": "List barbers for one of the signed-in user's salons.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "salon_id": {
              "type": "string",
              "format": "uuid",
              "description": "Salon UUID (from list_my_salons)."
