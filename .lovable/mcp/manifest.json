      },
      {
        "name": "list_services",
        "title": "List services",
        "description": "List services for one of the signed-in user's salons.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "salon_id": {
              "type": "string",
              "format": "uuid",
              "description": "Salon UUID (from list_my_salons)."
